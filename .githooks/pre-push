#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
uv --no-config sync --locked --group dev --group docs
uv --no-config run --locked ruff check src tests scripts
uv --no-config run --locked pytest -q --cov=pymc_monitor --cov-fail-under=85
scripts/build-docs.sh
uv --no-config run --locked python scripts/check_docs.py
uv --no-config run --locked python -m build
uv --no-config run --locked python scripts/check_artifact.py
uv --no-config run --locked python scripts/check_version.py
npm ci
npm run test:browser
